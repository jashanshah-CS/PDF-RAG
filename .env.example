# Copy this file to .env before using Docker Compose.
OLLAMA_MODEL=qwen3:8b
MAX_UPLOAD_MB=200

# Local Python runs normally use localhost. Docker Compose overrides this URL.
OLLAMA_CHAT_URL=http://localhost:11434/api/chat

# Set true only when the embedding model already exists in MODEL_CACHE.
EMBEDDING_LOCAL_ONLY=false
MODEL_CACHE=.model-cache
RAG_DATA_DIR=data

# Optional Windows override for non-standard Tesseract installations.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
